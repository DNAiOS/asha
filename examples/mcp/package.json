{
  "name": "@askasha/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Asha API, made by DNAi Systems: cited medical answers, claim checks, medication checks and evidence search as tools for coding agents.",
  "license": "Apache-2.0",
  "author": "DNAi Systems <hello@dnai.systems>",
  "homepage": "https://askasha.org/developers/docs/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DNAiOS/asha.git",
    "directory": "examples/mcp"
  },
  "type": "module",
  "bin": {
    "askasha-mcp": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "askasha": "^0.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
